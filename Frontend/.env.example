# Copie este arquivo para .env (ou .env.local) e ajuste se precisar.

# URL base da API. O padrão /api usa o proxy do Vite (vite.config.js), que repassa para
# http://localhost:8080 removendo o prefixo /api. Recomendado em desenvolvimento.
VITE_API_URL=/api

# Para chamar o backend direto, sem proxy, troque pela linha abaixo. A origem do frontend
# (ex.: http://localhost:5173) precisa estar em sos.cors.origens / CORS_ORIGENS do backend.
# VITE_API_URL=http://localhost:8080
